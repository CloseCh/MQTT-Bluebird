{
  "productName": "MQTT Bluebird",
  "appId": "com.close.mqttbluebird",
  "icon": "./public/icon.png",
  "asar": true,
  "compression": "normal",
  "files": [
    "dist-electron",
    "dist-react",
    "dist-preload",
    "!node_modules/**/*",
    "!**/*.map",
    "!**/*.d.ts"  
  ],
  "mac": {
    "target": "dmg",
    "category": "public.app-category.utilities"
  },
  "linux": {
    "executableName": "mqtt-bluebird",
    "target": ["AppImage", "deb"],
    "category": "Network;Utility"
  },
  "win": {
    "artifactName": "${productName}-${version}-Setup.${ext}",
    "target": {
      "target": "nsis",
      "arch": ["x64"]
    }
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true
  }
}