{
  "productName": "MQTT Bluebird",
  "appId": "com.close.mqttbluebird",
  "icon": "./public/icon.png",
  "asar": true,
  "compression": "normal",
  "files": [
    "dist-electron",
    "dist-react",
    "dist-preload",
    "!node_modules/**/*",
    "!**/*.map",
    "!**/*.d.ts"  
  ],
  "mac": {
    "target": "dmg"
  },
  "linux": {
    "target": "AppImage",
    "category": "Utility"
  },
  "win": {
    "target": {
      "target": "nsis",
      "arch": ["x64"]
    }
  }
}