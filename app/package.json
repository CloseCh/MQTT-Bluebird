  },
  "type": "module",
  "main": "dist-electron/main.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "type:validate": "tsc -b",
    "build": "tsc -b && electron-vite build",
    "lint": "eslint .",
    "dist:win": "tsc -b && electron-vite build && electron-builder --win --x64 --publish never",
    "dist:mac": "tsc -b && electron-vite build && electron-builder --mac --universal --publish never",
    "dist:linux": "tsc -b && electron-vite build && electron-builder --linux --x64 --publish never",
    "test": "vitest run",
    "build:web": "vite build --config vite.web.config.ts",
    "test:watch": "vitest"
  },
  "keywords": [],
  "author": {
    "name": "Weiyu",
