    "electron-builder": "26.8.1",
    "electron-vite": "5.0.0",
    "eslint": "10.3.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.2",
    "globals": "17.4.0",
    "jsdom": "29.1.1",
    "mqtt": "5.15.1",
