{
  "name": "mqtt_client",
  "version": "0.0.0",
  "description": "MQTT communication client",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "pnpm run dev:react & pnpm run dev:electron",
    "dev:react": "vite",
    "dev:electron": "pnpm run transpile:electron && cross-env NODE_ENV=development electron .",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "transpile:electron": "tsc --project src/electron/tsconfig.json",
    "dist:mac": "pnpm run transpile:electron && pnpm run build && electron-builder --mac --arm64",
    "dist:win": "pnpm run transpile:electron && pnpm run build && electron-builder --win --x64",
    "dist:linux": "pnpm run transpile:electron && pnpm run build && electron-builder --linux --x64"
  },
  "keywords": [],
  "author": "Weiyu",
  "license": "ISC",
  "packageManager": "pnpm@10.30.0+sha512.2b5753de015d480eeb88f5b5b61e0051f05b4301808a82ec8b840c9d2adf7748eb352c83f5c1593ca703ff1017295bc3fdd3119abb9686efc96b9fcb18200937",
  "dependencies": {
    "dotenv": "^17.3.1",
    "mqtt": "5.15.0",
    "os-utils": "0.0.14",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "3.7.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/os-utils": "0.0.4",
    "@types/react": "19.2.13",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.3",
    "cross-env": "10.1.0",
    "electron": "40.2.1",
    "electron-builder": "26.8.1",
    "eslint": "9.39.2",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-react-refresh": "0.5.0",
    "globals": "17.3.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.54.0",
    "vite": "7.3.1"
  }
}
