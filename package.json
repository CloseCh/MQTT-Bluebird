{
  "name": "mqtt_client",
  "version": "0.0.0",
  "description": "MQTT communication client",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev:react": "vite",
    "dev:electron": "pnpm run transpile:electron && cross-env NODE_ENV=development electron .",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "transpile:electron": "tsc --project src/electron/tsconfig.json",
    "dist:mac": "pnpm run transpile:electron && pnpm run build && electron-builder --mac --arm64",
    "dist:win": "pnpm run transpile:electron && pnpm run build && electron-builder --win --x64",
    "dist:linux": "pnpm run transpile:electron && pnpm run build && electron-builder --linux --x64"
  },
  "keywords": [],
  "author": "Weiyu",
  "license": "ISC",
  "packageManager": "pnpm@10.17.0",
  "dependencies": {
    "mqtt": "5.14.1",
    "os-utils": "0.0.14",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@eslint/js": "9.35.0",
    "@types/os-utils": "0.0.4",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "5.0.3",
    "cross-env": "10.0.0",
    "electron": "38.1.2",
    "electron-builder": "26.0.12",
    "eslint": "9.35.0",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.4.20",
    "globals": "16.4.0",
    "typescript": "5.9.2",
    "typescript-eslint": "8.44.0",
    "vite": "7.1.6"
  }
}
